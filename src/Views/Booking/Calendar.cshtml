        function updatePeriodDisplay(startDate, endDate, viewType) {
            const monthNames = [
                'Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6',
                'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'
            ];

            let displayText = '';

            if (viewType === 'timeGridWeek' || viewType === 'listWeek') {
                // Week view: show week range
                const start = new Date(startDate);
                const end = new Date(endDate);
                end.setDate(end.getDate() - 1); // Adjust end date for display

                if (start.getMonth() === end.getMonth()) {
                    // Same month
                    displayText = `${start.getDate()} - ${end.getDate()} ${monthNames[start.getMonth()]} ${start.getFullYear()}`;
                } else {
                    // Different months
                    displayText = `${start.getDate()} ${monthNames[start.getMonth()]} - ${end.getDate()} ${monthNames[end.getMonth()]} ${start.getFullYear()}`;
                }

                // Add week number
                const weekNumber = getWeekNumber(start);
                displayText = `Tuần ${weekNumber}: ${displayText}`;
            } else {
                // Month view: show month and year
                displayText = `${monthNames[startDate.getMonth()]} ${startDate.getFullYear()}`;
            }

            document.getElementById('currentPeriod').textContent = displayText;
        }

        function updateNavigationControls(viewType) {
            const weekNavigation = document.getElementById('weekNavigation');

            if (viewType === 'timeGridWeek' || viewType === 'listWeek') {
                weekNavigation.style.display = 'flex';
            } else {
                weekNavigation.style.display = 'none';
            }
        }

        function getWeekNumber(date) {
            const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
            const dayNum = d.getUTCDay() || 7;
            d.setUTCDate(d.getUTCDate() + 4 - dayNum);
            const yearStart = new Date(Date.UTC(d.getUTCFullYear(),0,1));
            return Math.ceil((((d - yearStart) / 86400000) + 1)/7);
        }

        function showNavigationFeedback(message) {
            // Create temporary feedback element
            const feedback = document.createElement('div');
            feedback.className = 'fixed top-4 right-4 bg-blue-600 text-white px-4 py-2 rounded-lg shadow-lg z-50 transition-all duration-300';
            feedback.textContent = message;
            feedback.style.transform = 'translateY(-20px)';
            feedback.style.opacity = '0';

            document.body.appendChild(feedback);

            // Animate in
            setTimeout(() => {
                feedback.style.transform = 'translateY(0)';
                feedback.style.opacity = '1';
            }, 10);

            // Animate out and remove
            setTimeout(() => {
                feedback.style.transform = 'translateY(-20px)';
                feedback.style.opacity = '0';
                setTimeout(() => {
                    if (feedback.parentNode) {
                        feedback.parentNode.removeChild(feedback);
                    }
                }, 300);
            }, 2000);
        }

        // Add keyboard shortcuts for week navigation
        document.addEventListener('keydown', function(e) {
            // Only work when no modal is open and no input is focused
            if (document.querySelector('.fixed:not(.hidden)') ||
                document.activeElement.tagName === 'INPUT' ||
                document.activeElement.tagName === 'TEXTAREA' ||
                document.activeElement.tagName === 'SELECT') {
                return;
            }

            const currentView = calendar.view.type;

            if (e.key === 'ArrowLeft' && (currentView === 'timeGridWeek' || currentView === 'listWeek')) {
                e.preventDefault();
                calendar.prev();
                showNavigationFeedback('← Tuần trước');
            } else if (e.key === 'ArrowRight' && (currentView === 'timeGridWeek' || currentView === 'listWeek')) {
                e.preventDefault();
                calendar.next();
                showNavigationFeedback('Tuần sau →');
            } else if (e.key === 'Home') {
                e.preventDefault();
                calendar.today();
                showNavigationFeedback('🏠 Tuần hiện tại');
            }
        });

