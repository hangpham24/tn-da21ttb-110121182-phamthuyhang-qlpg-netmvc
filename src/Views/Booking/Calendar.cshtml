        function confirmQuickBooking() {
            console.log('🚀 confirmQuickBooking called!');

            const classId = document.getElementById('quickBookingClass').value;
            const note = document.getElementById('quickBookingNote').value;

            console.log('📋 Form values:', {
                classId: classId,
                note: note,
                currentBookingDate: currentBookingDate
            });

            if (!classId) {
                alert('Vui lòng chọn lớp học');
                return;
            }

            if (!currentBookingDate) {
                console.error('❌ currentBookingDate is null!');
                alert('Lỗi: Không tìm thấy ngày đặt lịch');
                return;
            }

            // Disable button to prevent double-click
            const confirmBtn = event.target;
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Đang kiểm tra...';

            // ✅ FIXED: Format date in local timezone to avoid UTC shift issues
            const year = currentBookingDate.getFullYear();
            const month = String(currentBookingDate.getMonth() + 1).padStart(2, '0');
            const day = String(currentBookingDate.getDate()).padStart(2, '0');
            const dateOnly = `${year}-${month}-${day}`;
            const dateStr = `${dateOnly}T00:00:00`;

            console.log('🕐 Booking date:', {
                original: currentBookingDate,
                formatted: dateStr,
                dateOnly: dateOnly,
                classId: classId,
                classIdType: typeof classId,
                classIdParsed: parseInt(classId)
            });

            // ✅ STEP 1: Check availability first
            fetch(`@Url.Action("CheckAvailability")?classId=${classId}&date=${dateOnly}`)
            .then(response => response.json())
            .then(availabilityData => {
                console.log('🔍 Availability check result:', availabilityData);

                if (!availabilityData.canBook) {
                    // Show detailed capacity information
                    const message = `
                        ❌ ${availabilityData.message}

                        📊 Thông tin chi tiết:
                        • Sức chứa tối đa: ${availabilityData.totalCapacity} người
                        • Đã đăng ký khoảng thời gian: ${availabilityData.activeRegistrations || 0} người
                        • Đã booking buổi này: ${availabilityData.currentBookings || 0} người
                        • Tổng đã chiếm: ${availabilityData.totalOccupied || 0} người
                        • Còn trống: ${availabilityData.availableSlots || 0} chỗ

                        Vui lòng chọn lớp khác hoặc ngày khác.
                    `;
                    alert(message);

                    // Re-enable button
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = 'Xác nhận đặt lịch';
                    return;
                }

                // ✅ STEP 2: If available, proceed with booking
                confirmBtn.textContent = 'Đang đặt lịch...';
                return bookClass();
            })
            .catch(error => {
                console.error('Error checking availability:', error);
                alert('Lỗi khi kiểm tra sức chứa. Vui lòng thử lại!');

                // Re-enable button
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Xác nhận đặt lịch';
            });

            // ✅ STEP 3: Actual booking function
            function bookClass() {
                return fetch('@Url.Action("BookClass", "Booking")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        classId: parseInt(classId),
                        date: dateStr,
                        note: note
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Đặt lịch thành công!');
                        closeQuickBookingModal();
                        // Refresh calendar to show new booking
                        calendar.refetchEvents();
                        loadTodaySchedule();
                        loadQuickStats();
                    } else {
                        alert(data.message || 'Đã xảy ra lỗi khi đặt lịch');
                    }
                })
                .catch(error => {
                    console.error('Error booking class:', error);
                    alert('Lỗi kết nối. Vui lòng thử lại!');
                })
                .finally(() => {
                    // Re-enable button
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = 'Xác nhận đặt lịch';
                });
            }
        }

        function loadTodaySchedule() {
            // Load today's schedule from API
            const today = new Date().toISOString().split('T')[0];
            const url = '@Url.Action("GetCalendarEvents", "Booking")';
            const params = new URLSearchParams({
                start: today + 'T00:00:00',
                end: today + 'T23:59:59'
            });
            
            fetch(`${url}?${params}`)
                .then(response => response.json())
                .then(data => {
                    console.log('Today schedule loaded:', data);
                    if (Array.isArray(data) && data.length > 0) {
                        let html = '<div class="space-y-2">';
                        data.forEach(event => {
                            html += `
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                    <div>
                                        <div class="font-medium text-gray-900">${event.title}</div>
                                        <div class="text-sm text-gray-600">${event.start ? new Date(event.start).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) : 'N/A'} - ${event.end ? new Date(event.end).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) : 'N/A'}</div>
                                    </div>
                                    <span class="text-xs px-2 py-1 rounded" style="background-color: ${event.backgroundColor}; color: white;">${event.status}</span>
                                </div>
                            `;
                        });
                        html += '</div>';
                        updateTodaySchedule(html);
                    } else {
                        updateTodaySchedule('<div class="text-center py-4 text-gray-500"><p>Không có lịch nào hôm nay</p></div>');
                    }
                })
                .catch(error => {
                    console.error('Error loading today schedule:', error);
                    updateTodaySchedule('<div class="text-center py-4 text-red-500"><p>Lỗi khi tải lịch hôm nay</p></div>');
                });
        }

        function updateTodaySchedule(html) {
            document.getElementById('todaySchedule').innerHTML = html;
        }

        function showQuickRegister() {
            document.getElementById('quickRegisterModal').classList.remove('hidden');
        }

        function closeQuickRegisterModal() {
            document.getElementById('quickRegisterModal').classList.add('hidden');
        }

        function loadQuickStats() {
            // Load quick stats from API
            fetch('@Url.Action("MyBookings")')
                .then(response => response.text())
                .then(html => {
                    // Parse HTML to count bookings (simplified approach)
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const rows = doc.querySelectorAll('table tbody tr');
                    
                    document.getElementById('totalBookings').textContent = rows.length || '0';
                    document.getElementById('thisWeekBookings').textContent = '0'; // Would need more logic
                    document.getElementById('upcomingBookings').textContent = '0'; // Would need more logic
                    document.getElementById('completedBookings').textContent = '0'; // Would need more logic
                })
                .catch(error => {
                    console.error('Error loading quick stats:', error);
                    document.getElementById('totalBookings').textContent = '0';
                    document.getElementById('thisWeekBookings').textContent = '0';
                    document.getElementById('upcomingBookings').textContent = '0';
                    document.getElementById('completedBookings').textContent = '0';
                });
        }

        function showAlternativeClasses(date) {
            // Close current modal
            closeEventModal();

            // Show quick booking modal for the same date
            showQuickBooking(new Date(date + 'T00:00:00'));
        }

        function getStatusText(status) {
            switch(status) {
                case 'BOOKED': return 'Đã đặt';
                case 'CANCELED': return 'Đã hủy';
                case 'ATTENDED': return 'Đã tham gia';
                case 'AVAILABLE': return 'Khả dụng';
                case 'FULL': return 'Đã đầy';
                case 'NEARLY_FULL': return 'Sắp đầy';
                default: return status || 'Không xác định';
            }
        }

        function editBooking(bookingId) {
            console.log('Edit booking:', bookingId);
            alert('Chức năng chỉnh sửa đặt lịch sẽ được triển khai trong phiên bản tiếp theo.');
        }

        function cancelBooking(bookingId) {
            if (confirm('Bạn có chắc chắn muốn hủy đặt lịch này không?')) {
                console.log('Cancel booking:', bookingId);
                alert('Chức năng hủy đặt lịch sẽ được triển khai trong phiên bản tiếp theo.');
            }
        }

        function closeEventModal() {
            document.getElementById('eventModal').classList.add('hidden');
        }

        function closeQuickBookingModal() {
            document.getElementById('quickBookingModal').classList.add('hidden');
        }

        // New function for quick register from calendar event
        function quickRegisterClass(lopHocId, date) {
            console.log('Quick register for class:', lopHocId, 'on date:', date);

            // First check if class is still available (real-time check)
            fetch(`@Url.Action("CheckAvailability")?classId=${lopHocId}&date=${date}`)
                .then(response => response.json())
                .then(data => {
                    if (data.canBook) {
                        // Open quick booking with pre-selected class
                        showQuickBooking(new Date(date + 'T00:00:00'), lopHocId);
                    } else {
                        // Show full class message
                        alert('Lớp này hiện tại đã đầy. Vui lòng chọn lớp khác hoặc ngày khác.');
                        // Refresh calendar to show updated status
                        calendar.refetchEvents();
                    }
                })
                .catch(error => {
                    console.error('Error checking availability:', error);
                    // Fallback to showing booking modal
                    showQuickBooking(new Date(date + 'T00:00:00'), lopHocId);
                });
        }

        // Close modals when clicking outside
        document.getElementById('eventModal').addEventListener('click', function(e) {
            if (e.target === this) closeEventModal();
        });

        document.getElementById('quickBookingModal').addEventListener('click', function(e) {
            if (e.target === this) closeQuickBookingModal();
        });

        document.getElementById('quickRegisterModal').addEventListener('click', function(e) {
            if (e.target === this) closeQuickRegisterModal();
        });
    </script>
